#!/usr/bin/env python3
import argparse
import shutil
import subprocess
import sys
from pathlib import Path


def ensure_tool(name: str, install_hint: str) -> None:
    if shutil.which(name) is None:
        print(f"Missing required tool: {name}", file=sys.stderr)
        print(f"Install it with: {install_hint}", file=sys.stderr)
        raise SystemExit(1)


def get_output_path(value: str | None) -> Path:
    if value:
        output = Path(value).expanduser()
        return output if output.suffix.lower() == ".mp3" else output.with_suffix(".mp3")
    return Path.cwd() / "youtube_audio.mp3"


def download_youtube_mp3(video_url: str, output_path: Path) -> None:
    ensure_tool("ffmpeg", "sudo apt install ffmpeg\n  or\nbrew install ffmpeg")
    ensure_tool("yt-dlp", "python -m pip install yt-dlp")

    output_path.parent.mkdir(parents=True, exist_ok=True)

    command = [
        "yt-dlp",
        "-f",
        "bestaudio/best",
        "--extract-audio",
        "--audio-format",
        "mp3",
        "--audio-quality",
        "0",
        "-o",
        str(output_path.with_suffix("")),
        video_url,
    ]

    print(f"Downloading '{video_url}' to '{output_path}'")
    try:
        subprocess.run(command, check=True)
    except subprocess.CalledProcessError as exc:
        print(f"Download failed for: {video_url}", file=sys.stderr)
        raise SystemExit(exc.returncode) from exc

    if output_path.exists():
        print(f"Done! Saved MP3 at: {output_path}")
        return

    # yt-dlp may produce a file using the same base name but with a .mp3 extension.
    fallback = output_path.with_suffix(".mp3")
    if fallback.exists():
        print(f"Done! Saved MP3 at: {fallback}")
        return

    print("The download completed, but the expected MP3 file was not found.", file=sys.stderr)
    raise SystemExit(1)


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Download a YouTube video as an MP3 file."
    )
    parser.add_argument("url", help="YouTube video URL")
    parser.add_argument(
        "-o",
        "--output",
        help="Output MP3 path (e.g. ./song.mp3). Default: ./youtube_audio.mp3",
    )
    args = parser.parse_args()

    output_path = get_output_path(args.output)
    download_youtube_mp3(args.url, output_path)


if __name__ == "__main__":
    main()
